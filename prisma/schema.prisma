generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String          @id @default(cuid())
  numeroColegiado String?         @unique
  nombre          String
  correo          String          @unique
  password        String
  rol             Rol             @default(COLEGIADO)
  especialidad    String?
  ciudad          String?
  cedula          String?
  telefono        String?
  estado          EstadoColegiado @default(VIGENTE)
  alta            Int             @default(2024)
  vigencia        String?
  horas           Int             @default(0)
  horasMeta       Int             @default(60)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  inscripciones InscripcionCurso[]
  pagos         Pago[]
  expediente    Expediente?
  solicitudes   SolicitudPlan[]
}

enum Rol {
  ADMIN
  COLEGIADO
}

enum EstadoColegiado {
  VIGENTE
  POR_RENOVAR
  SUSPENDIDO
}

model Curso {
  id          String      @id @default(cuid())
  codigo      String      @unique
  titulo      String
  descripcion String?
  imagen      String?
  area        String      @default("General")
  horas       Int
  modalidad   String
  lugar       String
  instructor  String
  fechaInicio DateTime
  fechaFin    DateTime
  cupo        Int
  precio      Float
  estado      EstadoCurso @default(ABIERTO)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  modulos    ModuloCurso[]
  inscritos  InscripcionCurso[]
  pagos      Pago[]
}

enum EstadoCurso {
  ABIERTO
  EN_CURSO
  LLENO
  COMPLETADO
}

model ModuloCurso {
  id      String    @id @default(cuid())
  cursoId String
  titulo  String
  orden   Int
  curso   Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  lecciones Leccion[]
}

enum TipoRecurso {
  VIDEO_LINK
  DOCUMENTO
  IMAGEN
  TEXTO
  LINK_EXTERNO
}

model Leccion {
  id          String           @id @default(cuid())
  moduloId    String
  titulo      String
  descripcion String?
  orden       Int
  modulo      ModuloCurso      @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  recursos    RecursoLeccion[]
  completadas LeccionCompletada[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RecursoLeccion {
  id        String      @id @default(cuid())
  leccionId String
  tipo      TipoRecurso
  titulo    String
  url       String?
  contenido String?
  tamano    Int?
  orden     Int         @default(0)
  leccion   Leccion     @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model LeccionCompletada {
  id            String           @id @default(cuid())
  inscripcionId String
  leccionId     String
  createdAt     DateTime         @default(now())
  inscripcion   InscripcionCurso @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  leccion       Leccion          @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@unique([inscripcionId, leccionId])
}

model InscripcionCurso {
  id           String            @id @default(cuid())
  usuarioId    String
  cursoId      String
  progreso     Int               @default(0)
  moduloActual Int               @default(0)
  calificacion Float?
  folio        String?
  estado       EstadoInscripcion @default(INSCRITO)
  createdAt    DateTime          @default(now())

  usuario             Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso               Curso               @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  leccionesCompletadas LeccionCompletada[]

  @@unique([usuarioId, cursoId])
}

enum EstadoInscripcion {
  INSCRITO
  EN_CURSO
  COMPLETADO
  BLOQUEADO
}

model Evento {
  id        String   @id @default(cuid())
  fecha     DateTime
  tipo      String
  titulo    String
  hora      String
  lugar     String
  createdAt DateTime @default(now())
}

model Aviso {
  id        String   @id @default(cuid())
  tipo      String
  categoria String
  titulo    String
  contenido String
  fijado    Boolean  @default(false)
  imagen    String?  // JSON payload: {url, nombre, tipo, bytes}
  createdAt DateTime @default(now())
}

model DirectorioMiembro {
  id        String   @id @default(cuid())
  nombre    String
  cargo     String
  area      String   @default("Mesa Directiva")
  foto      String?  // JSON payload: {url, nombre, tipo, bytes}
  email     String?
  telefono  String?
  bio       String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pago {
  id          String    @id @default(cuid())
  usuarioId   String
  concepto    String
  monto       Float
  estado      String
  folio       String    @unique
  comprobante String?
  cursoId     String?
  vencimiento DateTime?
  createdAt   DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso?  @relation(fields: [cursoId], references: [id], onDelete: SetNull)
}

// ─── Expedientes ─────────────────────────────────────────────────

enum EstadoExpediente {
  ACTIVO
  ARCHIVADO
}

enum TipoEntrada {
  NOTA
  INSTRUCCION
  DOCUMENTO
  OBSERVACION
  REPORTE
}

model Expediente {
  id            String           @id @default(cuid())
  usuarioId     String           @unique
  nombre        String
  instrucciones String?
  estado        EstadoExpediente @default(ACTIVO)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  usuario  Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entradas EntradaExpediente[]
}

model EntradaExpediente {
  id           String      @id @default(cuid())
  expedienteId String
  tipo         TipoEntrada @default(NOTA)
  titulo       String
  contenido    String?
  archivo      String?
  autor        String?
  createdAt    DateTime    @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
}

model PlanPago {
  id          String          @id @default(cuid())
  nombre      String
  descripcion String?
  monto       Float
  iva         Boolean         @default(false)
  tipo        String          @default("OTRO")
  activo      Boolean         @default(true)
  solicitudes SolicitudPlan[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SolicitudPlan {
  id        String   @id @default(cuid())
  planId    String
  plan      PlanPago @relation(fields: [planId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estado    String   @default("PENDIENTE")
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, usuarioId])
}

model DocumentoAdmin {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  categoria     String   @default("General")
  url           String   // Vercel Blob CDN URL
  nombreArchivo String
  tipoMime      String
  bytes         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
